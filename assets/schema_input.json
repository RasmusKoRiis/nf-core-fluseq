{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/RasmusKoRiis/nf-core-fluseq/master/assets/schema_input.json",
    "title": "nf-core-fluseq FASTQ sample sheet",
    "description": "Accepted routine barcode and explicit FASTQ sample-sheet layouts.",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "SequenceID": { "type": "string", "minLength": 1 },
            "Barcode": { "type": "string", "minLength": 1 },
            "sample_id": { "type": "string", "minLength": 1 },
            "barcode": { "type": "string", "minLength": 1 },
            "sample": { "type": "string", "minLength": 1 },
            "fastq_1": { "type": "string", "pattern": "^\\S+\\.f(ast)?q\\.gz$" },
            "fastq_2": {
                "anyOf": [
                    { "type": "string", "pattern": "^\\S+\\.f(ast)?q\\.gz$" },
                    { "type": "string", "maxLength": 0 }
                ]
            }
        },
        "oneOf": [
            { "required": ["SequenceID", "Barcode"] },
            { "required": ["sample_id", "barcode"] },
            { "required": ["sample", "fastq_1"] }
        ]
    }
}
