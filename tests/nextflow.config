process.executor = 'local'

docker.enabled = true

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    // Pipeline acceptance data is private. Tests must use committed synthetic
    // fixtures unless FLUSEQ_ACCEPTANCE_DATA is explicitly supplied locally.
    pipelines_testdata_base_path = System.getenv('FLUSEQ_ACCEPTANCE_DATA') ?: "${projectDir}/data/"
}
