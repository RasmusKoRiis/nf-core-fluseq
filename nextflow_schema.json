{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/RasmusKoRiis/nf-core-fluseq/master/nextflow_schema.json",
    "title": "nf-core-fluseq parameters",
    "description": "Reproducible analysis of human and avian influenza FASTQ or FASTA input.",
    "type": "object",
    "$defs": {
        "path_file": {
            "type": "string",
            "format": "file-path",
            "exists": true
        },
        "path_directory": {
            "type": "string",
            "format": "directory-path",
            "exists": true
        }
    },
    "properties": {
        "file": {
            "type": "string",
            "enum": ["human-fastq", "human-fasta", "avian-fastq", "avian-fasta"],
            "default": "human-fastq",
            "description": "Pipeline mode. Exactly one mode is run."
        },
        "input": {
            "$ref": "#/$defs/path_file",
            "pattern": "^\\S+\\.(csv|tsv)$",
            "description": "FASTQ sample sheet. Routine SequenceID/Barcode and canonical sample/fastq_1/fastq_2 sheets are accepted."
        },
        "fasta": {
            "$ref": "#/$defs/path_file",
            "pattern": "^\\S+\\.(fa|fna|fas|fasta)(\\.gz)?$",
            "description": "Multi-FASTA input for a FASTA mode."
        },
        "samples_dir": {
            "$ref": "#/$defs/path_directory",
            "description": "Root directory containing barcode FASTQ directories or relative paths from the sample sheet."
        },
        "samplesDir": {
            "$ref": "#/$defs/path_directory",
            "description": "Deprecated alias for samples_dir.",
            "hidden": true
        },
        "outdir": {
            "type": "string",
            "format": "directory-path",
            "default": "results",
            "description": "Output directory."
        },
        "runid": { "type": "string", "default": "Unknown" },
        "season": { "type": "string" },
        "seq_instrument": { "type": "string", "default": "Nanopore-GN_GBX03008" },
        "release_version": { "type": "string", "default": "master" },
        "data_origin": { "type": "string", "default": "BioNumerics" },
        "drug_resistance_only": {
            "type": "boolean",
            "default": false,
            "description": "Run the reduced human FASTA drug-resistance path."
        },
        "seq_quality_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 80
        },
        "seq_quality_thershold": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Deprecated alias for seq_quality_threshold.",
            "hidden": true
        },
        "ha_database": { "$ref": "#/$defs/path_file", "description": "Pinned HA subtype database." },
        "na_database": { "$ref": "#/$defs/path_file", "description": "Pinned NA subtype database." },
        "genotype_database": { "$ref": "#/$defs/path_file", "description": "Pinned avian genotype database." },
        "reassortment_database": { "$ref": "#/$defs/path_file", "description": "Pinned reassortment database." },
        "mammalian_mutation_db": { "$ref": "#/$defs/path_file", "description": "Pinned mammalian mutation workbook." },
        "inhibition_mutation_db": {
            "$ref": "#/$defs/path_file",
            "description": "Pinned antiviral-inhibition mutation workbook."
        },
        "mamalian_mutation_db": {
            "$ref": "#/$defs/path_file",
            "description": "Deprecated alias for mammalian_mutation_db.",
            "hidden": true
        },
        "inhibtion_mutation_db": {
            "$ref": "#/$defs/path_file",
            "description": "Deprecated alias for inhibition_mutation_db.",
            "hidden": true
        },
        "sequence_references": {
            "$ref": "#/$defs/path_directory",
            "description": "Versioned sequence-reference directory."
        },
        "nextclade_dataset": {
            "$ref": "#/$defs/path_directory",
            "description": "Versioned local Nextclade dataset directory."
        },
        "mutation_tables": { "$ref": "#/$defs/path_directory", "description": "Optional mutation-table directory." },
        "reference": { "type": "string", "description": "Deprecated unused parameter.", "hidden": true },
        "publish_dir_mode": {
            "type": "string",
            "enum": ["copy", "copyNoFollow", "link", "rellink", "symlink"],
            "default": "copy",
            "hidden": true
        },
        "email": { "type": "string", "format": "email" },
        "email_on_fail": { "type": "string", "format": "email" },
        "plaintext_email": { "type": "boolean", "default": false, "hidden": true },
        "monochrome_logs": { "type": "boolean", "default": false, "hidden": true },
        "hook_url": { "type": "string", "hidden": true },
        "multiqc_config": { "$ref": "#/$defs/path_file" },
        "multiqc_title": { "type": "string" },
        "multiqc_logo": { "$ref": "#/$defs/path_file" },
        "multiqc_methods_description": { "$ref": "#/$defs/path_file" },
        "max_multiqc_email_size": { "type": "string", "default": "25.MB", "hidden": true },
        "max_cpus": { "type": "integer", "minimum": 1, "default": 16, "hidden": true },
        "max_memory": { "type": "string", "default": "128.GB", "hidden": true },
        "max_time": { "type": "string", "default": "240.h", "hidden": true },
        "validate_params": { "type": "boolean", "default": true, "hidden": true },
        "help": { "type": "boolean", "default": false, "hidden": true },
        "helpFull": { "type": "boolean", "default": false, "hidden": true },
        "showHidden": { "type": "boolean", "default": false, "hidden": true },
        "version": { "type": "boolean", "default": false, "hidden": true },
        "config_profile_name": { "type": "string", "hidden": true },
        "config_profile_description": { "type": "string", "hidden": true },
        "config_profile_contact": { "type": "string", "hidden": true },
        "config_profile_url": { "type": "string", "hidden": true },
        "custom_config_version": { "type": "string", "hidden": true },
        "custom_config_base": { "type": "string", "hidden": true },
        "server_work_dir": { "type": "string", "format": "directory-path", "hidden": true }
    },
    "required": ["file", "outdir"],
    "allOf": [
        {
            "if": {
                "properties": { "file": { "enum": ["human-fastq", "avian-fastq"] } },
                "required": ["file"]
            },
            "then": {
                "required": ["input"],
                "anyOf": [{ "required": ["samples_dir"] }, { "required": ["samplesDir"] }]
            }
        },
        {
            "if": {
                "properties": { "file": { "enum": ["human-fasta", "avian-fasta"] } },
                "required": ["file"]
            },
            "then": { "required": ["fasta"] }
        },
        {
            "if": {
                "properties": { "file": { "enum": ["avian-fastq", "avian-fasta"] } },
                "required": ["file"]
            },
            "then": {
                "required": [
                    "ha_database",
                    "na_database",
                    "genotype_database",
                    "reassortment_database",
                    "mammalian_mutation_db",
                    "inhibition_mutation_db",
                    "sequence_references",
                    "nextclade_dataset"
                ]
            }
        },
        {
            "if": {
                "properties": { "file": { "enum": ["human-fastq", "human-fasta"] } },
                "required": ["file"]
            },
            "then": {
                "required": [
                    "ha_database",
                    "na_database",
                    "inhibition_mutation_db",
                    "sequence_references",
                    "nextclade_dataset"
                ]
            }
        }
    ]
}
