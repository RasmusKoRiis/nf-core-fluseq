/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on the NIPH server
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
    nextflow run RasmusKoRiis/nf-core-fluseq -profile server --input <SAMPLESHEET> --outdir <OUTDIR>

    Each parameter can be overridden on the command line

----------------------------------------------------------------------------------------
*/

// Clean intermediate files on successful run
cleanup = false

params {
    config_profile_name        = 'Server profile'
    config_profile_description = 'Parameters and settings for running nf-core-fluseq on the NIPH local server'
    server_work_dir            = '/mnt/tempdata/work_fluseq'

    max_cpus   = 16
    max_memory = '256.GB'
    max_time   = '20.h'

}

process.resourceLimits = [
    cpus: 16,
    memory: '256.GB',
    time: '20.h'
]
