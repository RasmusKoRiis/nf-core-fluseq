/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Explicit public output contract
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Processes are unpublished by default. Only stable user-facing results are copied or
    linked out of the work directory. All report variants retain `reporthuman/` because
    the operational wrappers upload CSV files from that location.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [enabled: false]

    withName: IRMA {
        publishDir = [
            path: { "${params.outdir}/irma" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: SUBTYPEFINDER {
        publishDir = [
            path: { "${params.outdir}/subtyping" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: GENOTYPING {
        publishDir = [
            path: { "${params.outdir}/genotyping" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: REASSORTMENT {
        publishDir = [
            path: { "${params.outdir}/reassortment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: NEXTCLADE {
        publishDir = [
            path: { "${params.outdir}/nextclade" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: SUBCLADE_NOMENCLATURE {
        publishDir = [
            path: { "${params.outdir}/subclade" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'FLUMUT|FLUMUT_CONVERSION' {
        publishDir = [
            path: { "${params.outdir}/flumut" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'GENIN2|SLIM_GENIN2_REPORT' {
        publishDir = [
            path: { "${params.outdir}/genin2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'REPORTHUMAN|REPORTHUMANFASTA|REPORT_AVIAN|REPORTAVIANFASTA' {
        publishDir = [
            path: { "${params.outdir}/reporthuman" },
            mode: params.publish_dir_mode,
            pattern: '*.csv'
        ]
    }

    withName: DRUG_RESISTANCE_REPORT {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: '*.csv'
        ]
    }

    withName: SURVEILLANCE_SUMMARY {
        publishDir = [
            path: { "${params.outdir}/surveillance" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    withName: REFERENCE_PROVENANCE {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: 'reference_manifest.tsv'
        ]
    }

    withName: MULTIQC {
        ext.args = params.multiqc_title ? "--title \"${params.multiqc_title}\"" : ''
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
